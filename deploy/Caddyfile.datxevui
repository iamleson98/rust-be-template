# datxevui-datxevui — site block appended to the SHARED Caddyfile
# (/opt/pdf-tts/Caddyfile) by /opt/vexevn/deploy.sh. Idempotent: the
# marker comment above makes re-runs skip; if a pdf-tts redeploy ever
# replaces the shared Caddyfile, the next datxevui deploy re-appends it.
#
# DNS prerequisite: A records for datxevui.com AND www.datxevui.com →
# this server's public IP. Caddy then automatically issues/renews
# Let's Encrypt certs on :443 (HTTP-01 via :80) — no manual cert steps.

datxevui.com, www.datxevui.com {
	# Compress responses in transit. Caddy skips responses that are
	# already Content-encoded, so the backend's own gzip isn't doubled.
	encode zstd gzip

	# SPA + API + WebSocket (chat) + SSE all live on the backend's one
	# origin (:8080). `datxevui_backend` is the swarm DNS name of the
	# datxevui stack's backend service on the shared overlay network.
	reverse_proxy datxevui_backend:8080 {
		# Disable response buffering so SSE/chat streams flush immediately.
		flush_interval -1
		transport http {
			response_header_timeout 120s
		}
	}
}
