# /etc/datxevui/env — secrets and per-site values for datxevui.service,
# datxevui-places.service and datxevui-backup.service. bootstrap.sh installs
# this file once (root:datxevui, 0640) and never overwrites it. Values are
# KEY=value, one per line, no quotes and no `export`.
#
# datxevui.service already sets the box-specific defaults (127.0.0.1:8080,
# app.db, uploads/, places/, static dir, client-IP source); anything set here
# overrides them. src/config/mod.rs and .env.example list every other setting.

# ── Sessions ────────────────────────────────────────────────────────
# MUST be the Worker's current JWT_SECRET and JWT_ISSUER: Wrangler secrets
# cannot be read back, so copy them from where you stored them. A different
# secret signs every user and mobile session out at cutover.
JWT_SECRET=
JWT_ISSUER=
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://datxevui.com,https://www.datxevui.com
OAUTH_REDIRECT_BASE_URL=https://datxevui.com
OAUTH_FRONTEND_URL=https://datxevui.com
PAYMENT_PUBLIC_BASE_URL=https://datxevui.com

# ── Backups (datxevui-backup.service) ───────────────────────────────
# Any S3-compatible target: the RustFS/MinIO bucket from deploy/, R2, B2...
# Leave BACKUP_S3_BUCKET empty to keep only the local copies in
# /var/lib/datxevui/backups.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=datxevui
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Local copies kept (4 per day) and days of remote history kept.
BACKUP_KEEP_LOCAL=8
BACKUP_KEEP_REMOTE_DAYS=30

# ── Integrations carried over from the Worker ───────────────────────
# Same values as the Worker's secrets; add the rest of the keys from
# .env.example (OAuth client secrets, APNS_*, FCM_CREDENTIALS_JSON,
# GOOGLE_ADS_*, VIETQR_*) as the features need them. docs/CUTOVER.md has the
# full checklist.
AUDIO_CALL_TURN_AUTH_MODE=cloudflare
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
VIETQR_ENABLED=true
PAYMENT_COD_ENABLED=true
MOMO_ENABLED=false
ZALOPAY_ENABLED=false
VNPAY_ENABLED=false
