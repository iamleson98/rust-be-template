[Unit]
Description=Rebuild the datxevui place index weekly

[Timer]
# Host local time; bootstrap.sh sets the host to Asia/Ho_Chi_Minh, so
# this is Monday 03:30 ICT, the quietest hour of the week.
OnCalendar=Mon *-*-* 03:30:00
RandomizedDelaySec=10min
# A box that was off at 03:30 builds when it comes back.
Persistent=true

[Install]
WantedBy=timers.target
