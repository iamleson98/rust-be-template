# ─── Caddyfile for HTTPS reverse proxy ──────────────────────────────
#
# Caddy automatically provisions Let's Encrypt TLS certificates.
#
# ⚠️  IMPORTANT: Replace 'yourdomain.com' with your actual domain.
#
# Setup:
#   1. Ensure DNS A record points to the VM's public IP
#   2. Copy this file to the VM: /etc/caddy/Caddyfile
#   3. Restart: systemctl restart caddy
#   4. Allow UDP/443 on the firewall for HTTP/3 (QUIC).
#
# If using Docker Compose, you don't need Caddy — the backend
# serves the frontend directly on :8080. Use Caddy only for:
#   - HTTPS termination
#   - HTTP/3 (QUIC)
#   - Brotli/gzip compression
#   - Security headers

yourdomain.com {
    # ── Reverse proxy to backend ─────────────────────────────────
    reverse_proxy localhost:8080 {
        # Pass real client IP + protocol to the backend (so tower_governor
        # can rate-limit per IP, and the audit log shows real origins).
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # Flush immediately so SSE / chunked transfer (streaming CSV export,
        # WebSocket upgrades) reach the client without buffering.
        flush_interval -1
    }

    # ── Security headers ─────────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' wss: ws: https://www.google-analytics.com https://region1.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        X-XSS-Protection "1; mode=block"
        # Remove Server header for security through obscurity
        -Server
    }

    # ── Compression ───────────────────────────────────────────────
    # Caddy auto-negotiates between gzip + zstd (RFC 8878).
    encode zstd gzip

    # ── Static asset caching ─────────────────────────────────────
    # The Rust backend already sets Cache-Control headers on static
    # files, but we also cache at the Caddy layer for CDN-like perf.
    @static path /assets/* /sw.js /icon-*.png /manifest.json
    header @static Cache-Control "public, max-age=31536000, immutable"

    # ── WebSocket support ────────────────────────────────────────
    # Caddy handles WS upgrades automatically when reverse_proxy is set.
    # No special config needed — just ensure the upstream supports WS.

    # ── Health check endpoint (no caching) ───────────────────────
    @health path /health /ready
    header @health Cache-Control "no-cache, no-store, must-revalidate"

    # ── API rate limiting (bypassed for WS upgrades) ─────────────
    # The Rust backend already has tower_governor rate limiting.
    # Caddy's rate limiting is a second layer for DDoS protection.
    # Uncomment to enable:
    # rate_limit {
    #     zone dynamic {
    #         key {remote_host}
    #         events 100
    #         window 10s
    #     }
    # }

    # ── Access logs ──────────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}

# ── HTTP → HTTPS redirect ───────────────────────────────────────────
# Caddy does this automatically when a domain block has HTTPS enabled.
# No explicit redirect block needed.

# ── www → non-www redirect (optional) ──────────────────────────────
# www.yourdomain.com {
#     redir https://yourdomain.com{uri} permanent
# }
