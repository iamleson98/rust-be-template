# Configuration for the backend.
#
# Naming convention: Single uppercase identifiers with single underscores.
# Copy this file to `.env` and customize.
#
# ⚠️  SECURITY: never commit real secrets. All values below are PLACEHOLDERS.
# Generate strong values with `cargo run -- key generate` (JWT secret) and
# `cargo run -- key hash <password>` (argon2 hashes). For OAuth client
# secrets and payment HMAC keys, obtain them from the respective provider
# dashboards and store them ONLY in your local `.env` (which is gitignored)
# or, in production, in a real secret manager (Vault, AWS SSM, Doppler, etc.).

# ── Server ──────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,backend=debug,tower_http=info
SERVER_REQUEST_TIMEOUT_SECS=30
SERVER_MAX_REQUEST_BODY_BYTES=2097152
SERVER_TCP_KEEPALIVE_SECS=60
SERVER_TCP_NODELAY=true
SERVER_VALHALLA_URL=

# ── Database (rust-sql engine — the only backend) ───────────────────────
# sea-orm on the pure-Rust rustqlite engine, compiled into the binary.
# The URL scheme is sqlite:// (the dialect the engine speaks).
DATABASE_URL=sqlite://./app.db?mode=rwc
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SECS=10
DATABASE_IDLE_TIMEOUT_SECS=600
DATABASE_MAX_LIFETIME_SECS=1800
DATABASE_STATEMENT_CACHE_CAPACITY=100
DATABASE_ENABLE_SQLX_LOGS=false

# ── JWT ────────────────────────────────────────────────────────────────
# MUST be at least 32 bytes in production! Generate with `cargo run -- key generate`.
JWT_SECRET=replace-with-output-of-cargo-run---key-generate-min-32-bytes
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800
JWT_ISSUER=backend

# ── Cookie ─────────────────────────────────────────────────────────────
# Cookie domain — leave EMPTY for same-origin (dev + production when
# Rust serves both UI + API on the same origin). The browser will
# scope cookies to the request's host automatically.
# Only set this if you need cross-subdomain cookies (e.g.
# COOKIE_DOMAIN=vexevn.vn for app.vexevn.vn + api.vexevn.vn).
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── CSRF ───────────────────────────────────────────────────────────────
CSRF_TOKEN_TTL_SECS=3600

# ── Cache ──────────────────────────────────────────────────────────────
# Options: moka, redis
CACHE_BACKEND=moka
CACHE_TTL_SECS=300
CACHE_MAX_CAPACITY=100000
CACHE_REDIS_URL=redis://127.0.0.1:6379/0

# ── Storage ────────────────────────────────────────────────────────────
# Options: local, s3, minio, rustfs
# Route pictures are the first consumer: the backend validates +
# thumbnails uploads and stores them here; reads go through
# STORAGE_PUBLIC_BASE_URL (CDN) when set, else the backend's own
# /api/media/{key} proxy (dev default).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=app-uploads
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
STORAGE_S3_FORCE_PATH_STYLE=false
# Public CDN origin for media reads. Production (RustFS behind the
# shared Caddy): https://media.datxevui.com — image URLs emitted by
# the API point there and image bytes never flow through the backend.
# Empty/unset (dev): URLs point at the backend's /api/media proxy.
# STORAGE_PUBLIC_BASE_URL=https://media.datxevui.com

# ── RustFS (production object storage; deploy/stack.yml service) ───────
# Root credentials for the rustfs container — the backend reuses them
# as its S3 keys (writes are signed; reads hit the public bucket
# through the CDN origin). Generate with: openssl rand -hex 16
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=

# ── Worker ─────────────────────────────────────────────────────────────
# Options: redis, db, kafka. Default `db`: the queue lives in the
# app's rust-sql database — zero new infrastructure
# for a single-binary deployment (set `redis`/`kafka` to scale out).
WORKER_BACKEND=db
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_KAFKA_BROKERS=127.0.0.1:9092
WORKER_KAFKA_GROUP_ID=backend-workers
WORKER_KAFKA_TOPIC=jobs

# ── Background-jobs scheduler ──────────────────────────────────────────
# Gates the worker runner AND the recurring-job scheduler (the biweekly
# Vietnam OSM → Tantivy refresh, see src/jobs/). Set `false` for a
# pure-API instance: schedules still list on /admin/cron-jobs, but
# nothing fires and "run now" returns 503.
SCHEDULER_ENABLED=true
# Fixed UTC offset (minutes) used to interpret each schedule's "run at
# HH:MM" wall-clock time. Default 420 = UTC+7 (Vietnam — no DST, so a
# fixed offset is exact).
SCHEDULER_TZ_OFFSET_MINUTES=420
# How often due schedules are checked (seconds).
SCHEDULER_TICK_INTERVAL_SECS=60

# ── Rate Limit ─────────────────────────────────────────────────────────
RATE_LIMIT_RPM=600
RATE_LIMIT_BURST=100

# ── Static Files ───────────────────────────────────────────────────────
STATIC_FILES_DIR=./frontend/dist
STATIC_FILES_CACHE_MAX_AGE=86400

# ── Search / OSM ───────────────────────────────────────────────────────
SEARCH_INDEX_DIR=./osm-index
SEARCH_OSM_PBF_PATH=./data/vietnam-latest.osm.pbf
# OSM extract download URL for the scheduled `osm.import` job
# (default: Geofabrik Vietnam; point at a mirror if needed).
# SEARCH_OSM_DOWNLOAD_URL=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── WebSocket ──────────────────────────────────────────────────────────
WS_MAX_CONNECTIONS=50000
WS_MAX_PER_IP=10
WS_CHANNEL_CAPACITY=256
WS_HEARTBEAT_SEC=30
WS_IDLE_TIMEOUT_SEC=90
WS_MAX_MESSAGE_BYTES=65536
WS_MAX_FRAME_BYTES=65536

# ── Redis (production) ─────────────────────────────────────────────────
# Required when CACHE_BACKEND=redis or WORKER_BACKEND=redis.
# Used by docker-compose.prod.yml — missing this will fail the deploy.
REDIS_PASSWORD=change_me_in_production

# ── NullClaw AI (built into the backend — no external container) ───────
# When enabled, the backend calls the LLM API directly to generate AI
# chat replies when no human agent is online.
# Uses OpenAI-compatible API (Gemini, OpenAI, etc.).
NULLCLAW_ENABLED=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
NULLCLAW_TIMEOUT_MS=15000
NULLCLAW_MAX_HISTORY=12
NULLCLAW_FALLBACK_ONLINE_EMPLOYEES=1

# ── Audio Call ─────────────────────────────────────────────────────────
AUDIO_CALL_ENABLED=true
# STUN/TURN servers pushed to every WebRTC peer in the `registered`
# message (over the authed WS). JSON array, same shape as
# RTCPeerConnection iceServers. CRITICAL for mobile networks: two peers
# behind CGNAT (5G ↔ home WiFi) can almost never hole-punch with STUN
# alone — a TURN relay is what makes calls actually connect.
# Deploy coturn (deploy/stack.yml runs it alongside the backend) and set:
# AUDIO_CALL_ICE_SERVERS=[{"urls":["stun:YOUR_SERVER_IP:3478","turn:YOUR_SERVER_IP:3478?transport=udp","turn:YOUR_SERVER_IP:3478?transport=tcp"],"username":"vexevn","credential":"CHANGE_ME_TURN_SECRET"}]
# Empty → clients fall back to public Google STUN (works only on
# NAT-tolerant networks).
AUDIO_CALL_ICE_SERVERS=

# Firebase service-account JSON for FCM device push ("ring even when
# the app is closed"). Paste the WHOLE file as ONE line (jq -c) or
# keep empty to disable push. See deploy/README.md "Push (FCM)".
# FCM_CREDENTIALS_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
FCM_CREDENTIALS_JSON=

# ── Payment gateways ───────────────────────────────────────────────────
PAYMENT_PUBLIC_BASE_URL=http://127.0.0.1:8080
PAYMENT_DEFAULT_EXPIRY_MINUTES=10
PAYMENT_COD_ENABLED=true

# VNPay
VNPAY_ENABLED=false
VNPAY_ENV=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# MoMo
MOMO_ENABLED=false
MOMO_ENV=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ZaloPay
ZALOPAY_ENABLED=false
ZALOPAY_ENV=sandbox
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# VietQR
VIETQR_ENABLED=false
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# ── Contact info ───────────────────────────────────────────────────────
CONTACT_PHONE=+8419006067
CONTACT_EMAIL=hotro@datxevui.vn
CONTACT_ADDRESS=123 Lê Lợi, Q.1, TP.HCM
CONTACT_ZALO_URL=https://zalo.me/123456789
CONTACT_FACEBOOK_URL=https://facebook.com/datxevui

# ── Messaging Platform Webhooks (optional) ────────────────────────────
# Enable customer support chat via Zalo/Messenger/Telegram/Discord.
# Each platform requires its own API credentials. See DEPLOYMENT.md.
# Zalo OA
ZALO_OA_ID=
ZALO_OA_SECRET=
# Facebook Messenger
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Discord Bot
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# ── OAuth 2.0 ──────────────────────────────────────────────────────────
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
OAUTH_FRONTEND_URL=http://localhost:3000

# Facebook
OAUTH_FACEBOOK_ENABLED=false
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_SCOPES=

# Google — DO NOT commit real client_id / client_secret. Obtain from
# Google Cloud Console → APIs & Services → Credentials.
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_SCOPES=openid,profile,email

# X / Twitter
OAUTH_TWITTER_ENABLED=false
OAUTH_TWITTER_CLIENT_ID=
OAUTH_TWITTER_CLIENT_SECRET=
OAUTH_TWITTER_SCOPES=
