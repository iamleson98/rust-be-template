# Configuration for the backend.
#
# Naming convention: use double-underscore (__) to separate nested keys.
#   SERVER__HOST       → config.server.host
#   DATABASE__URL      → config.database.url
#   STATIC_FILES__DIR  → config.static_files.dir
#
# Copy this file to `.env` and customize. Values here override defaults
# from the Rust code; environment variables override `.env` values.

# ── Server ──────────────────────────────────────────────────────────────
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
RUST_LOG=info,backend=debug,tower_http=info
SERVER__REQUEST_TIMEOUT_SECS=30
SERVER__MAX_REQUEST_BODY_BYTES=2097152
SERVER__TCP_KEEPALIVE_SECS=60
SERVER__TCP_NODELAY=true

# ── Database ───────────────────────────────────────────────────────────
# Two backends are supported via cargo features:
#
#   SQLite (default, dev/CI):
#     DATABASE__URL=sqlite://./app.db?mode=rwc
#     cargo build                    # uses --features sqlite (default)
#
#   Postgres (production):
#     DATABASE__URL=postgres://user:pass@localhost:5432/dbname
#     cargo build --no-default-features --features postgres
#
# The backend is auto-detected from the URL scheme (`sqlite://` vs
# `postgres://`). SQLite gets performance pragmas applied automatically
# (WAL mode, sync=NORMAL, busy_timeout, cache_size, mmap_size,
# foreign_keys=ON). Postgres needs no pragmas — FK enforcement is on
# by default, and MVCC handles concurrent readers/writers natively.
#
# To run the Postgres migration test locally:
#   docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=test_db --name pg-test postgres:17
#   TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/test_db \
#     cargo test --test migration_compat --no-default-features \
#       --features postgres -- --include-ignored
DATABASE__URL=sqlite://./app.db?mode=rwc
DATABASE__MAX_CONNECTIONS=20
DATABASE__MIN_CONNECTIONS=5
DATABASE__CONNECT_TIMEOUT_SECS=10
DATABASE__IDLE_TIMEOUT_SECS=600
DATABASE__MAX_LIFETIME_SECS=1800
DATABASE__STATEMENT_CACHE_CAPACITY=100
DATABASE__ENABLE_SQLX_LOGS=false

# ── JWT ────────────────────────────────────────────────────────────────
# MUST be at least 32 bytes in production!
JWT__SECRET=8ec7dc585377c32aaa59104b093be930bb094ff4e6b32e580351e3d0d702a084
JWT__ACCESS_TTL_SECS=900
JWT__REFRESH_TTL_SECS=604800
JWT__ISSUER=backend

# ── Cookie ─────────────────────────────────────────────────────────────
COOKIE__DOMAIN=localhost
COOKIE__SECURE=false
COOKIE__SAMESITE=lax

# ── CSRF ───────────────────────────────────────────────────────────────
CSRF__TOKEN_TTL_SECS=3600

# ── Cache ──────────────────────────────────────────────────────────────
# Options: moka, redis
CACHE__BACKEND=moka
CACHE__TTL_SECS=300
CACHE__MAX_CAPACITY=100000
CACHE__REDIS_URL=redis://localhost:6379/0

# ── Storage ────────────────────────────────────────────────────────────
# Options: local, s3, minio
STORAGE__BACKEND=local
STORAGE__LOCAL_ROOT=./storage
STORAGE__S3_REGION=us-east-1
STORAGE__S3_BUCKET=app-uploads
STORAGE__S3_ACCESS_KEY_ID=
STORAGE__S3_SECRET_ACCESS_KEY=
# STORAGE__S3_ENDPOINT=http://localhost:9000
STORAGE__S3_FORCE_PATH_STYLE=false

# ── Worker ─────────────────────────────────────────────────────────────
# Options: redis, db, kafka
WORKER__BACKEND=redis
WORKER__CONCURRENCY=4
WORKER__POLL_INTERVAL_MS=1000
WORKER__KAFKA_BROKERS=localhost:9092
WORKER__KAFKA_GROUP_ID=backend-workers
WORKER__KAFKA_TOPIC=jobs

# ── Rate Limit ─────────────────────────────────────────────────────────
# Requests per minute allowed per client IP. Default: 600 (10 req/sec).
# Set lower (e.g. 120) for public production deployments; set higher
# (e.g. 1200) for internal tools or dev environments.
RATE_LIMIT__RPM=600
# Burst size — max number of requests allowed in a short burst before
# the per-second refill rate kicks in. Default: 100. A SPA page load
# can easily make 5-10 concurrent API calls; a burst of 10 (the old
# default) would 429 on the second page load.
RATE_LIMIT__BURST=100

# ── Static Files ───────────────────────────────────────────────────────
STATIC_FILES__DIR=./frontend/dist
STATIC_FILES__CACHE_MAX_AGE=86400

# ── Search / OSM ───────────────────────────────────────────────────────
# Directory for the Tantivy place index (built by `import-osm`)
SEARCH__INDEX_DIR=./osm-index
# Path to the OSM PBF file (download via scripts/download-vietnam-osm.sh)
SEARCH__OSM_PBF_PATH=./data/vietnam-latest.osm.pbf

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated origin list
CORS__ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Payment gateways ───────────────────────────────────────────────────
# All providers are optional — disable the ones you don't use.
# Each provider has an `enabled` flag + sandbox/production env switch.

# Public base URL of the app (used to build returnUrl / ipnUrl).
PAYMENT__PUBLIC_BASE_URL=http://localhost:8080
PAYMENT__DEFAULT_EXPIRY_MINUTES=10
PAYMENT__COD_ENABLED=true

# VNPay (sandbox self-serve at https://sandbox.vnpayment.vn/devreg)
PAYMENT__VNPAY__ENABLED=false
PAYMENT__VNPAY__ENV=sandbox
PAYMENT__VNPAY__TMN_CODE=
PAYMENT__VNPAY__HASH_SECRET=

# MoMo (sandbox creds at https://developers.momo.vn)
PAYMENT__MOMO__ENABLED=false
PAYMENT__MOMO__ENV=sandbox
PAYMENT__MOMO__PARTNER_CODE=
PAYMENT__MOMO__ACCESS_KEY=
PAYMENT__MOMO__SECRET_KEY=

# ZaloPay (sandbox at https://docs.zalopay.vn)
PAYMENT__ZALOPAY__ENABLED=false
PAYMENT__ZALOPAY__ENV=sandbox
PAYMENT__ZALOPAY__APP_ID=
PAYMENT__ZALOPAY__KEY1=
PAYMENT__ZALOPAY__KEY2=

# VietQR (no merchant contract — uses your business bank account).
# Bank BIN list: https://vietqr.net/danh-sach-ma-ngan-hang
# Examples: Vietcombank=970436, MBBank=970422, Techcombank=970407, BIDV=970409
PAYMENT__VIETQR__ENABLED=false
PAYMENT__VIETQR__BANK_BIN=
PAYMENT__VIETQR__ACCOUNT_NO=
PAYMENT__VIETQR__ACCOUNT_NAME=

# ── Contact info (used in UI + SEO) ────────────────────────────────
CONTACT__PHONE=+8419006067
CONTACT__EMAIL=hotro@vexevn.vn
CONTACT__ADDRESS=123 Lê Lợi, Q.1, TP.HCM
CONTACT__ZALO_URL=https://zalo.me/123456789
CONTACT__FACEBOOK_URL=https://facebook.com/vexevn

# ── OAuth 2.0 (social login — Facebook / Google / X-Twitter) ────────
# Each provider is optional. Leave `enabled=false` (or unset the client
# id/secret) to disable that provider — the corresponding
# /api/auth/oauth/<provider>/* routes will return 404.
#
# `REDIRECT_BASE_URL` is the publicly-reachable backend URL — must
# match exactly the redirect URI registered in the provider's dashboard.
# `FRONTEND_URL` is where the user lands after a successful OAuth flow.
OAUTH__REDIRECT_BASE_URL=http://localhost:8080
OAUTH__FRONTEND_URL=http://localhost:5173

# Facebook (create app at https://developers.facebook.com)
OAUTH__FACEBOOK__ENABLED=false
OAUTH__FACEBOOK__CLIENT_ID=
OAUTH__FACEBOOK__CLIENT_SECRET=
# Optional: override default scopes "email public_profile"
OAUTH__FACEBOOK__SCOPES=

# Google (create credentials at https://console.cloud.google.com/apis/credentials)
OAUTH__GOOGLE__ENABLED=false
OAUTH__GOOGLE__CLIENT_ID=
OAUTH__GOOGLE__CLIENT_SECRET=
# Optional: override default scopes "openid email profile"
OAUTH__GOOGLE__SCOPES=

# X / Twitter (create app at https://developer.twitter.com)
OAUTH__TWITTER__ENABLED=false
OAUTH__TWITTER__CLIENT_ID=
OAUTH__TWITTER__CLIENT_SECRET=
# Optional: override default scopes "users.read tweet.read offline.access"
OAUTH__TWITTER__SCOPES=
