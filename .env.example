# ===== Server =====
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,backend=debug,tower_http=debug
# Hard per-request timeout (seconds). Returns 408 if exceeded.
REQUEST_TIMEOUT_SECS=30
# Max request body size in bytes (default 2 MB).
MAX_REQUEST_BODY_BYTES=2097152
# TCP keepalive interval (seconds). None = use OS default.
TCP_KEEPALIVE_SECS=60
# Disable Nagle's algorithm for lower latency on small writes.
TCP_NODELAY=true

# ===== Database =====
# Either backend works at runtime — the URL scheme selects which driver is used.
#   SQLite (default for dev/CI):  sqlite://./app.db?mode=rwc
#   Postgres (prod/scaling):      postgres://user:pass@host:5432/db
#
# Note: you must also enable the matching cargo feature at build time:
#   cargo build                              # uses default = sqlite
#   cargo build --no-default-features --features postgres
DATABASE_URL=sqlite://./app.db?mode=rwc
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_CONNECT_TIMEOUT_SECS=10
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800
DB_STATEMENT_CACHE_CAPACITY=100
DB_ENABLE_SQLX_LOGS=false

# ===== JWT =====
JWT_SECRET=change-me-in-production-please-use-32-bytes-or-more
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800
JWT_ISSUER=backend

# ===== Cookies =====
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ===== CSRF =====
CSRF_TOKEN_TTL_SECS=3600

# ===== Cache =====
# one of: moka | redis
CACHE_BACKEND=moka
CACHE_TTL_SECS=300
CACHE_MAX_CAPACITY=100000
REDIS_URL=redis://localhost:6379/0

# ===== Storage =====
# one of: local | s3 | minio
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
S3_REGION=us-east-1
S3_BUCKET=app-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                    # blank for AWS, set for MinIO/custom
S3_FORCE_PATH_STYLE=false

# ===== Worker =====
# one of: redis | db | kafka
WORKER_BACKEND=redis
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=backend-workers
KAFKA_TOPIC=jobs

# ===== Rate limit =====
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# ===== Static files =====
STATIC_DIR=./static
STATIC_CACHE_MAX_AGE=86400

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
