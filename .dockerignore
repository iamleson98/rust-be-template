# ─── .dockerignore — exclude files from Docker build context ────────
# Reduces build context size → faster builds + smaller push.

# Git
.git
.gitignore
.gitattributes

# Build artifacts
target/
frontend/dist/
frontend/node_modules/

# Database files
*.db
*.db-shm
*.db-wal
app.db*

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docs / scripts (not needed in Docker image)
*.md
docs/
scripts/
.github/
.terraform/
terraform/

# Env files (use --env-file at runtime, not bake into image)
.env
.env.local
.env.*.local

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# ZeroClaw config (mounted at runtime, not baked into image)
zeroclaw.config.json

# Caddy (used on the VM, not in Docker)
Caddyfile
