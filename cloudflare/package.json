{
  "name": "datxevui-cloudflare",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "db:generate": "drizzle-kit generate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "places:build": "bun scripts/build-place-shards.ts",
    "places:fetch": "bash scripts/fetch-place-index.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/realtimekit": "^2.0.3",
    "@cloudflare/realtimekit-react": "^2.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-table": "^9.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "p-retry": "^8.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^3.0.6",
    "shadcn": "^4.21.4",
    "sharp": "^0.34.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.1"
  },
  "description": "datxevui — Next.js on Cloudflare Workers (D1 + R2 + Realtime)"
}
