# Local development secrets (never committed values — dev only)
JWT_SECRET=change-me-min-16-chars
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800
CRON_SERVICE_TOKEN=change-me
PAYMENT_PUBLIC_BASE_URL=http://localhost:3000
APP_ENV=development

# Session cookie policy: lax (default, first-party production) | none
# (cross-site-capable preview: SameSite=None; Secure; Partitioned — CHIPS).
COOKIE_SAMESITE=none

# Cloudflare Realtime (RealtimeKit) — leave empty to run chat in REST/polling mode
REALTIME_ENABLED=false
REALTIME_APP_ID=
REALTIME_ACCOUNT_ID=
REALTIME_API_TOKEN=

# Calls: customers may only call from these countries (staff exempt). Local dev
# has no edge country, so the gate is open there regardless.
CALL_ALLOWED_COUNTRIES=VN
AUDIO_CALL_RING_TIMEOUT_SECS=60

# Device push so a CLOSED phone app still rings (all optional; unset = off).
# FCM_CREDENTIALS_JSON = the Firebase service-account JSON (Android);
# APNS_* = the .p8 key group (iOS VoIP / CallKit).
FCM_CREDENTIALS_JSON=
APNS_KEY_PEM=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_SANDBOX=false

# Cloudflare Calls TURN (managed relay for /ws-call audio) — leave empty
# to fall back to public STUN (P2P works only on NAT-friendly networks).
# Create a TURN key: Cloudflare dashboard → Realtime → TURN.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Payment gateways (dev off)
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VIETQR_ENABLED=true
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
MOMO_ENABLED=false
ZALOPAY_ENABLED=false
