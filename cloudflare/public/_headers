# Browser hardening for every static response (dynamic ones get the same values
# from src/lib/edge-guard.ts).
/*
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Static asset caching for the Workers deployment
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Place-search index (rebuilt weekly with each deploy): revalidate hourly so a
# new index is picked up without a client holding a week-old shard.
/places/*
  Cache-Control: public,max-age=3600

# Fonts, icons and images are not content-hashed: a day in the browser, then a
# week of stale-while-revalidate, instead of a revalidation request per visit.
/fonts/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/icons/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/hero-*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/logo*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/og-image.png
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/manifest.webmanifest
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800

# The service worker must always be revalidated or updates never ship.
/sw.js
  Cache-Control: no-cache
