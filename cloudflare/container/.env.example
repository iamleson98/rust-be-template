# Container runtime configuration (set these in the Cloudflare dashboard,
# as Docker build args, or via your deployment pipeline):
#
# APP_URL=https://datxevui.<your-subdomain>.workers.dev
#   → The deployed Next.js Worker URL whose /api/jobs/tick is driven.
#
# CRON_SERVICE_TOKEN=<same value as the Worker's CRON_SERVICE_TOKEN secret>
#   → Shared service-to-service token (wrangler secret put CRON_SERVICE_TOKEN).
#
# TICK_INTERVAL_MS=60000     (default: every minute)
# WARM_INTERVAL_MS=21600000  (default: every 6 hours)
# PORT=8080                  (default; must match the DO wrapper port)
