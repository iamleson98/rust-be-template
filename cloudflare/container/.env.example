# The CronContainer Durable Object passes these to the container on start
# (custom-worker.ts) from the Worker's own configuration — Containers have no
# separate dashboard env. Set them on the Worker:
#
#   wrangler.jsonc  vars:    APP_URL=https://<your-domain>
#   wrangler secret put CRON_SERVICE_TOKEN
#
# Optional overrides (defaults shown) can be added to the start() env:
# TICK_INTERVAL_MS=60000
# WARM_INTERVAL_MS=21600000
# PORT=8080  (must match the DO wrapper's getTcpPort)
