<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch background: brand off-white + centered "dx + heart" logo
     (drawable-nodpi/launch_logo.png). Replaced by the Flutter splash the
     moment the engine draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
