# ── API base URL ────────────────────────────────────────────────────
# In the browser, this is NOT used — the SDK uses RELATIVE URLs
# (e.g. /api/auth/me) so all requests go through the Vite proxy in
# dev (same-origin) or the Rust static server in production (same-origin).
# This eliminates all CORS + cookie cross-origin issues.
#
# This env var is ONLY used for SSR/prerender where window is undefined.
# In dev, Vite proxies /api, /ws to localhost:8080 automatically.
# In production, the Rust backend serves the UI at the same origin.
VITE_API_BASE_URL=

# ── Google integrations ─────────────────────────────────────────────
# All values are OPTIONAL — the app works without them.

# Google Search Console verification token
# Get from: Search Console → Settings → Ownership verification → HTML tag
# Leave empty in dev; set only in production.
VITE_GSC_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
# Get from: analytics.google.com → Admin → Data Streams
# Leave empty in dev; set only in production.
VITE_GA4_ID=

# ── Google Ads (conversion tracking) ─────────────────────────────────
# See docs/GOOGLE_ADS.md for the full setup walkthrough.
# All values are OPTIONAL — without them, conversion calls are no-ops.

# Google Ads tag ID (AW-XXXXXXXXX)
# Get from: Google Ads → Goals → Conversions → tag setup (use the
# SAME Google account as the GA4 ID above where possible).
VITE_GOOGLE_ADS_ID=

# Conversion labels per event, as JSON. The keys are the two events
# this app fires: "booking" (booking confirmed) and "purchase"
# (payment completed). Get each label from the conversion's tag setup.
# Example:
# VITE_GOOGLE_ADS_CONVERSIONS={"booking":"AW-123456789/AbC-123","purchase":"AW-123456789/DeF-456"}
VITE_GOOGLE_ADS_CONVERSIONS=

# ── Google AdSense (only if monetizing — NOT for SEO) ────────────────
# AdSense does NOT boost SEO ranking. Only set these if you want to
# earn ad revenue from your site. Requires Google AdSense approval.
# VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_GOOGLE_ADSENSE_SLOT_HOME=1234567890
# VITE_GOOGLE_ADSENSE_SLOT_SEARCH=0987654321
