# ──────────────────────────────────────────────────────────────────────
# terraform/terraform.tfvars — TEMPLATE. Copy to terraform.tfvars
# (which is gitignored) and fill in your real values.
#
# Get credentials: Kamatera console → My Cloud → API Keys → Add Key.
# ⚠ SECURITY: terraform.tfvars is gitignored for a reason — committing
# these values exposes LIVE infrastructure credentials. The 2026-10-14
# audit found exactly that in git history (see docs/SECURITY.md).
# Alternative: export TF_VAR_kamatera_api_token / TF_VAR_kamatera_api_secret
# instead of using a tfvars file at all.
# ──────────────────────────────────────────────────────────────────────
kamatera_api_token = "REPLACE_WITH_KAMATERA_CLIENT_ID"
kamatera_api_secret = "REPLACE_WITH_KAMATERA_SECRET"
